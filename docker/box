#!/usr/bin/env bash
#
# box — run a dev box on a worktree.
#
# Derives the whole `docker run` line from the feature name: the worktree
# to mount at /work, the container name, and the Emacs server name. The
# raw command it stands for, flag by flag, is in README.md.
#
# Naming a feature is enough: if it has no worktree yet, this is its
# first box, so the worktree is made — with a branch of that name, or
# checking out the branch if it already exists.

set -euo pipefail

usage() {
    cat <<'EOF'
usage: box <feature>          a box on .worktrees/<feature>, made if new
       box --bare <feature>   the same, with a bare Emacs config instead
       box --close <feature>  close it: container, worktree, branch
       box -d <feature>       discard it: the same three, work and all
       box                    list the worktrees you can name
       box --names            those names alone, for completion
       box --rebuild          rebuild the maf image, for newer agents
       box --help             this text

One box per feature branch, several at once. A feature with no worktree
gets one, and a branch to go with it, both named after it.

A box runs my own Emacs: ~/.emacs.d is copied in at startup, packages and
all. --bare leaves it out, for a box that wants stock Emacs and only the
legacy Calc config the port skill reads. Either way it is settled when
the container is made, so an existing box has to go before it changes.

--close is for a feature that has landed. Merge it first: it refuses a
branch that is not merged, a worktree holding changes, or the tree you
are standing in. -d is for one you are throwing away, and forces past
the first two — uncommitted changes go, unmerged commits go.

The agents (claude, codex) are installed into the image, so every box
runs the versions the image was built with. --rebuild refreshes them;
box says when the image has aged enough to be worth it. Boxes already
made keep the old image until closed and remade.

Tab completion for bash, zsh and fish: docker/completions/
EOF
}

# --help before anything else, so it answers outside a repo too.
case ${1-} in
    -h|--help)
        usage
        exit 0
        ;;
esac

# The main checkout, from the common git dir rather than the current
# toplevel: run from inside a worktree, --show-toplevel would name that
# worktree, so boxes would nest under it and $repo/.git would be a file
# instead of the repository.
if ! common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    # Completion is asked on every tab, including in directories that are
    # no repo at all. It answers nothing there rather than complaining.
    case ${1-} in
        --names|--complete) exit 0 ;;
    esac
    echo "box: not inside a git repository" >&2
    exit 1
fi
repo=$(dirname "$common")

branch_exists() { git show-ref --quiet --verify "refs/heads/$feature"; }

# The docker socket is root-owned unless you are in the docker group.
# Only the docker calls are elevated — the paths stay yours. Asked for
# only where docker is about to be used: completion runs on every tab
# and has no business probing the socket.
docker_sudo() {
    sudo=
    docker info >/dev/null 2>&1 || sudo=sudo
}

# The image a fresh box is cut from. Two ways it goes wrong, both quiet:
# absent, and docker takes `maf` for a registry name and pulls a stranger's
# image; present but built from an older Dockerfile, and the container comes
# up without the entrypoint that lays out the tmux session, so the box is a
# bare shell with no sign of what is missing. The entrypoint is the thing to
# look for either way — it is what the rest of this script assumes ran.
#
# A third way is slow rather than quiet: the agents are npm-installed into
# the image, root-owned, so they cannot update themselves in a box, and
# every box runs the versions of the day the image was built. Past a month
# that starts to show — features the host's agent has and the box's does
# not — so check_image says so, and --rebuild is the remedy.
build="docker build --build-arg UID=\$(id -u) --build-arg GID=\$(id -g) -t maf docker/"
# The entrypoint feature level this script counts on — LABEL
# maf.entrypoint in the Dockerfile, bumped there whenever the entrypoint
# gains something box relies on. 1: seeds Claude's model caches from
# /seed/claude.json.
entrypoint_level=1
image_age_days() {
    local created
    created=$($sudo docker image inspect -f '{{.Created}}' maf 2>/dev/null) || return 1
    echo $(( ($(date +%s) - $(date -d "$created" +%s)) / 86400 ))
}
build_image() {
    $sudo docker build --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" \
          -t maf "$repo/docker/"
}
check_image() {
    local entry age level
    if ! $sudo docker image inspect maf >/dev/null 2>&1; then
        echo "box: no maf image yet — building it (once per machine)" >&2
        build_image
        return
    fi
    # An image with no entrypoint at all has no Entrypoint key to index —
    # the template has to test it before reaching in, or it errors instead
    # of reporting the empty answer that is the whole point of asking.
    entry=$($sudo docker image inspect \
                  -f '{{if .Config.Entrypoint}}{{index .Config.Entrypoint 0}}{{end}}' maf)
    if [ "$entry" != /usr/local/bin/entrypoint ]; then
        # Rebuilding for them would overwrite an image this may not even be
        # — the tag is short enough for something else on the machine to have
        # taken it.
        echo "box: the maf image was not built from docker/Dockerfile" >&2
        echo "     (its entrypoint is ${entry:-none}, expected /usr/local/bin/entrypoint)" >&2
        echo "     rebuild it, keeping the old one first if it is still wanted:" >&2
        echo "     docker tag maf maf-old && $build" >&2
        exit 1
    fi
    # The image's entrypoint level, against the one this script wants.
    # Below it — or absent, from an image built before the label was —
    # and the boxes it makes come up fine but skip what the newer
    # entrypoint does, with nothing to say so; hence this. A warning
    # rather than a refusal: maf-old is kept to be fallen back to, and
    # falling back has to be allowed to.
    level=$($sudo docker image inspect -f '{{index .Config.Labels "maf.entrypoint"}}' maf)
    if [ "${level:-0}" -lt "$entrypoint_level" ]; then
        echo "box: the maf image predates this box script (entrypoint level ${level:-none}, wants $entrypoint_level)" >&2
        echo "     boxes made from it start, but skip what the newer entrypoint does —" >&2
        echo "     box --rebuild to catch it up (this box keeps the old image)" >&2
        return
    fi
    age=$(image_age_days) || return 0
    if [ "$age" -gt 30 ]; then
        echo "box: the maf image is $age days old, and so are the agents in it" >&2
        echo "     box --rebuild to refresh them (this box keeps the old image)" >&2
    fi
}
# --rebuild keeps the image being replaced as maf-old, the way the
# not-ours error above suggests by hand: a build that fails halfway
# leaves the tag where it was, and a build that succeeds leaves a way
# back if the new agents misbehave. Boxes already made are unaffected —
# a container holds its image — until closed and made again.
rebuild_image() {
    docker_sudo
    if $sudo docker image inspect maf >/dev/null 2>&1; then
        $sudo docker tag maf maf-old
        echo "box: previous image kept as maf-old" >&2
    fi
    build_image
    echo "box: rebuilt; boxes made from now on use it — existing ones keep the old image" >&2
}

# The feature names, bare and one per line — what completion consumes,
# and the reason no shell has to parse the listing above.
names() {
    local key rest
    while read -r key rest; do
        [ "$key" = worktree ] || continue
        case $rest in
            "$repo/.worktrees/"*) echo "${rest#"$repo"/.worktrees/}" ;;
        esac
    done < <(git worktree list --porcelain) | sort
}

close=
discard=
bare=
case ${1-} in
    --names)
        names
        exit 0
        ;;
    --complete)
        # bash `complete -C` runs: box --complete <command> <word> <prev>.
        # It does no filtering of its own, so match the prefix here — by
        # glob, so a word holding . or * stays literal.
        cur=${3-}
        names | while IFS= read -r name; do
            case $name in "$cur"*) echo "$name" ;; esac
        done
        exit 0
        ;;
    --rebuild)
        rebuild_image
        exit 0
        ;;
    --close)
        close=1
        shift
        ;;
    -d)
        discard=1
        shift
        ;;
    --bare)
        bare=1
        shift
        ;;
    -*)
        echo "box: unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
esac

if [ $# -eq 0 ] && [ -n "$close$discard$bare" ]; then
    echo "box: ${close:+--close}${discard:+-d}${bare:+--bare} needs a feature name" >&2
    usage >&2
    exit 1
fi

# Bare `box` is git's own listing kept to .worktrees/ — the main checkout
# is not a box, and what follows .worktrees/ is the name box takes. The
# branch in brackets is highlighted for a terminal only, so piped output
# stays git's own text.
if [ $# -eq 0 ]; then
    list=$(git worktree list | grep -F "$repo/.worktrees/") || exit 0
    if [ -t 1 ]; then
        esc=$(printf '\033')
        printf '%s\n' "$list" | sed "s/\[\([^]]*\)\]/[${esc}[1;36m\1${esc}[0m]/"
    else
        printf '%s\n' "$list"
    fi
    exit 0
fi

feature=$1
tree=$repo/.worktrees/$feature

# No worktree yet: this is the feature's first box, so make one. git's
# own -b names the branch rather than letting the path do it — for a
# feature like my/feature the basename alone would leave you on a branch
# called `feature`. A branch that already exists is checked out instead.
# --close and -d skip all this: they tolerate a half-cleaned feature.
if [ ! -d "$tree" ] && [ -z "$close$discard" ]; then
    if branch_exists; then
        git worktree add "$tree" "$feature"
    else
        git worktree add -b "$feature" "$tree"
    fi
fi

# A feature may hold slashes; a container name may not. The branch keeps
# the slash, the container does not.
box=${feature//\//-}

docker_sudo

# --close and -d take the same three things away — container, worktree,
# branch — and differ only in what they will step over. --close is for a
# feature that has landed: an unmerged branch or a worktree holding
# changes stops it, and stops it up front, since a step that balked after
# the container was gone would have taken away the one place set up to
# look into why. -d is for throwing the work out, so it forces past both.
# Either way, what is already gone counts as done, so a half-finished
# cleanup can be run again.
if [ -n "$close" ] || [ -n "$discard" ]; then
    # Both refuse this one: removing the worktree you are standing in
    # leaves the shell in a directory that is no longer there.
    case $PWD/ in
        "$tree"/*)
            echo "box: you are standing in $tree" >&2
            exit 1
            ;;
    esac

    if [ -n "$close" ]; then
        if [ -d "$tree" ] && [ -n "$(git -C "$tree" status --porcelain)" ]; then
            echo "box: $feature has uncommitted changes — commit them, or box -d to discard" >&2
            exit 1
        fi

        if branch_exists && ! git merge-base --is-ancestor "$feature" HEAD; then
            echo "box: $feature is not merged into $(git rev-parse --abbrev-ref HEAD)" >&2
            echo "     merge it first, or box -d $feature to discard it" >&2
            exit 1
        fi
    fi

    if [ -n "$discard" ]; then
        printf 'discarding %s\n' "$feature"
        wt_force=(--force)      # a worktree with changes in it
        br_delete=-D            # a branch whose commits went nowhere
    else
        printf 'closing %s\n' "$feature"
        wt_force=()
        br_delete=-d
    fi

    status() { printf '  %-34s %s\n' "$1" "$2"; }
    rc=0

    if [ -n "$($sudo docker ps -aq --filter "name=^maf-$box$")" ]; then
        if err=$($sudo docker rm -f "maf-$box" 2>&1 >/dev/null); then
            status "container maf-$box" removed
        else
            status "container maf-$box" "ERROR: $err"
            rc=1
        fi
    else
        status "container maf-$box" "none"
    fi

    if [ -d "$tree" ]; then
        if err=$(git worktree remove "${wt_force[@]}" "$tree" 2>&1); then
            status ".worktrees/$feature" removed
        else
            status ".worktrees/$feature" "ERROR: $err"
            rc=1
        fi
    else
        status ".worktrees/$feature" "none"
    fi

    if branch_exists; then
        if err=$(git branch "$br_delete" "$feature" 2>&1); then
            status "branch $feature" deleted
        else
            status "branch $feature" "ERROR: $err"
            rc=1
        fi
    else
        status "branch $feature" "none"
    fi

    exit $rc
fi

# Your agent config, each file mounted where its agent looks for it. On
# the host these are symlinks into ~/conf; a box skips the indirection
# and takes the real files. AGENTS.md is mounted twice: once for codex,
# once at the path CLAUDE.md imports it from.
conf=${MAF_CONF:-$HOME/conf}
mounts=()
mount_ro() {
    # Optional, all of them: an absent source is left unmounted rather
    # than handed to docker, which would make a directory in its place.
    [ -e "$1" ] && mounts+=(-v "$1:$2:ro")
    return 0
}
mount_ro "$conf/claude/CLAUDE.md"  /home/dev/.claude/CLAUDE.md
mount_ro "$conf/claude/keybindings.json" /home/dev/.claude/keybindings.json
mount_ro "$conf/agents/AGENTS.md"  /home/dev/conf/agents/AGENTS.md
mount_ro "$conf/agents/AGENTS.md"  /home/dev/.codex/AGENTS.md
mount_ro "$conf/codex/config.toml" /home/dev/.codex/config.toml
mount_ro "$conf/tmux/tmux.conf"   /home/dev/.config/tmux/tmux.conf

# Codex auth: mounted read-only at /seed and copied in by the
# entrypoint, so a token refresh inside the box writes to the
# container's copy and never the host file. Optional — a box without it
# still starts, and codex asks you to sign in there.
mount_ro "$HOME/.codex/auth.json" /seed/codex-auth.json

# Claude auth. A long-lived token minted by `claude setup-token`
# (~/.claude/box-token — per machine, good for a year; see
# conf/install/setup.org) rides in as an environment variable. It never
# rotates, unlike the live login's credentials, whose every refresh
# invalidates all other copies of them — seeding those into several
# boxes is why they kept asking to log in. The seeding remains only as
# the fallback when no token file exists. The environment is fixed at
# container creation, so a re-minted token reaches new boxes only.
claude_env=()
if [ -s "$HOME/.claude/box-token" ]; then
    claude_env=(-e "CLAUDE_CODE_OAUTH_TOKEN=$(<"$HOME/.claude/box-token")")
else
    mount_ro "$HOME/.claude/.credentials.json" /seed/credentials.json
fi

# Which models Claude offers. Its /model menu is built from entitlement
# caches in ~/.claude.json, filled in after a login — the token above is
# not one, so a box's copy stays empty and the menu falls back to the
# built-in list: no Fable, though `--model fable` works. Mounted at
# /seed for the entrypoint to copy those keys, and only those, into the
# box's own file on every start — nothing else in the host file (account,
# per-project state, history) is taken. Optional, like the rest of /seed.
mount_ro "$HOME/.claude.json" /seed/claude.json

# My whole Emacs config, seeded rather than mounted, since Emacs writes
# into it — the entrypoint copies it in. That carries my/calc along, so
# the narrow mount is only for --bare: the legacy Calc config the port
# skill reads, at the path that skill names.
if [ -n "$bare" ]; then
    mount_ro "$HOME/.emacs.d/my/calc" /home/dev/.emacs.d/my/calc
else
    mount_ro "$HOME/.emacs.d" /seed/emacs.d
fi

# Land in the tmux session the entrypoint laid out — Emacs beside a
# shell — and fall through to a plain shell when you detach, so C-b d
# leaves the box up rather than ending the container's main process
# with it. Exiting that shell still stops the box.
#
# attach keeps its stderr: the fall-through means a box whose session
# never came up still hands you a shell, and looks like an ordinary one.
# Whatever tmux has to say about the missing session is the only sign.
session=(bash -c 'tmux attach -t emacs; exec bash')

# Docker's detach sequence, moved off its C-p C-q default: C-p is
# previous-line, pressed constantly in the Emacs pane, and the client
# swallows it waiting to see whether C-q follows. C-q C-q costs only
# Emacs's quoted-insert of a literal C-q, which nothing here types.
detach=(--detach-keys 'ctrl-q,ctrl-q')

# A box outlives its shell, so naming one again revisits it rather than
# building a second: running, join it in another shell; stopped, start it
# back up. Only a name docker has never heard of is a fresh container.
# Nothing removes them — `docker rm maf-<feature>` when a feature is done.
state=$($sudo docker inspect -f '{{.State.Status}}' "maf-$box" 2>/dev/null) || state=

case $state in
    running)
        exec $sudo docker exec -it "${detach[@]}" "maf-$box" bash
        ;;
    "")
        check_image

        # Mounts: the worktree at /work, plus the main .git at its *host
        # path* — a worktree's .git file names that path absolutely, so
        # git inside the container only resolves if it matches exactly.
        exec $sudo docker run -it "${detach[@]}" --name "maf-$box" \
             --hostname "$box" \
             -v "$tree:/work" \
             -v "$repo/.git:$repo/.git" \
             -v "$HOME/.gitconfig:/home/dev/.gitconfig:ro" \
             "${mounts[@]}" \
             "${claude_env[@]}" \
             maf "${session[@]}"
        ;;
    *)
        # Exited, created, paused: the filesystem is as you left it. The
        # entrypoint runs again, so credentials are re-seeded and Emacs
        # comes back up — the tmux session did not survive the stop.
        #
        # What does not come back up to date is the mounts: a container
        # keeps the ones it was made with, so a box from before a mount
        # was added here restarts without it, and the entrypoint has
        # nothing to seed from. Only remaking the box gets it — say so.
        if [ -e "$HOME/.claude.json" ] \
           && ! $sudo docker inspect -f '{{range .Mounts}}{{.Destination}}{{"\n"}}{{end}}' "maf-$box" \
                | grep -qx /seed/claude.json; then
            echo "box: maf-$box was made before Claude's model menu was seeded into boxes;" >&2
            echo "     its /model lacks what the host's has (--model fable still works)." >&2
            echo "     box --close $feature and make it again to get it." >&2
        fi
        exec $sudo docker start -ai "${detach[@]}" "maf-$box"
        ;;
esac
