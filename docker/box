#!/usr/bin/env bash
#
# box — one dev container per feature branch.
#
#   docker/box build              build (or rebuild) the maf-dev image
#   docker/box up   <feature>     worktree + container + Emacs, ready to drive
#   docker/box eval <feature> SEXP   run elisp in that container's Emacs
#   docker/box sh   <feature>     interactive shell inside the container
#   docker/box ls                 list running boxes
#   docker/box down <feature>     stop the container (worktree kept)
#
# Layout: the branch lives in a host git worktree ($WORKTREES/<feature>),
# bind-mounted at /work. Edits and commits therefore land in the host
# repo — merging a finished feature is plain `git merge` on the host, no
# remotes, no pushing out of the container.

set -euo pipefail

REPO=$(git rev-parse --show-toplevel)
WORKTREES=${MAF_WORKTREES:-$(dirname "$REPO")/maf-worktrees}
IMAGE=maf-dev

# The docker socket is root-owned unless you are in the docker group.
if docker info >/dev/null 2>&1; then DOCKER=docker; else DOCKER="sudo docker"; fi

cmd=${1:-}; shift || true

case "$cmd" in
  build)
    $DOCKER build \
      --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" \
      -t "$IMAGE" "$REPO/docker"
    ;;

  up)
    feature=$1
    tree=$WORKTREES/$feature
    # New feature => new worktree on a new branch; existing one is reused.
    [ -d "$tree" ] || git -C "$REPO" worktree add "$tree" -b "$feature"
    # Mounts: the worktree at /work, plus the main .git at its *host
    # path* — a worktree's .git file names that path absolutely, so git
    # inside the container only resolves if the path matches exactly.
    $DOCKER run -d --name "maf-$feature" \
      -v "$tree:/work" \
      -v "$REPO/.git:$REPO/.git" \
      -e "MAF_SERVER_NAME=$feature" \
      "$IMAGE" tmux new-session -d -s maf 'emacs -nw' \; wait-for never
    # Wait for the Emacs server socket to answer before returning.
    for _ in $(seq 20); do
      $DOCKER exec "maf-$feature" emacsclient -s "$feature" --eval t \
        >/dev/null 2>&1 && break
      sleep 0.5
    done
    echo "box $feature up: $tree -> maf-$feature"
    ;;

  eval)
    feature=$1; shift
    $DOCKER exec "maf-$feature" emacsclient -s "$feature" --eval "$*"
    ;;

  sh)
    feature=$1
    $DOCKER exec -it "maf-$feature" bash
    ;;

  ls)
    $DOCKER ps --filter name=maf- --format '{{.Names}}\t{{.Status}}'
    ;;

  down)
    feature=$1
    $DOCKER rm -f "maf-$feature"
    ;;

  *)
    sed -n '3,12p' "$0" >&2
    exit 1
    ;;
esac
