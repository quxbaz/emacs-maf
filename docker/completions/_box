#compdef box
#
# zsh completion for box. Put this directory on your fpath, before
# compinit runs:
#
#   fpath=(/path/to/emacs-maf/docker/completions $fpath)
#   autoload -Uz compinit && compinit
#
# The file is named _box because that is the name zsh autoloads for the
# `box` command; the body below is the completion function itself.

local -a names
names=(${(f)"$(box --names 2>/dev/null)"})
compadd -a names
